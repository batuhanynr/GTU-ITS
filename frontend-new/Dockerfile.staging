FROM node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY public ./public
COPY src ./src
# Keep browser requests on the staging gateway's origin.
ENV REACT_APP_API_URL=/api
# Identify the staging environment on the login page.
ENV REACT_APP_STAGING=true
RUN npm run build

FROM nginx:stable-alpine@sha256:8eb04fe3b385090e9aa02961f77398ad09b6bf33ab07f6669a5bb7acce22c0d3
COPY nginx.staging.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
