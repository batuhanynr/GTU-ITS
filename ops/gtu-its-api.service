[Unit]
Description=GTU internship API
Requires=docker.service
After=docker.service postgresql.service network-online.target

[Service]
EnvironmentFile=/etc/gtu-its/release.env
ExecStart=/usr/bin/docker run --rm --name gtu-its-api --network host --env-file /etc/gtu-its/backend.env --read-only --tmpfs /tmp:rw,noexec,nosuid,size=64m --cap-drop ALL --security-opt no-new-privileges ${APP_IMAGE}
ExecStop=/usr/bin/docker stop --time 20 gtu-its-api
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
